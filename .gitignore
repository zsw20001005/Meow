# macOS 与编辑器的本机文件
.DS_Store
*.xcodeproj
xcuserdata/
*.xcuserstate
.idea/
*.swp
*.swo
*~

# 编译缓存、应用包、测试截图和临时下载；保留根目录 Package.resolved
/.build/
/.build-*/
/windows/**/bin/
/windows/**/obj/
/windows/**/node_modules/
/windows/Meow.MailBridge/node.exe
/build/
/.swiftpm/
/DerivedData/
__pycache__/
*.py[cod]
*.log
*.dSYM/

# 本机凭据与签名材料；可提交不含真实值的环境变量示例
.env
.env.*
!.env.example
!.env.*.example
*.keychain
*.keychain-db
*.p12
*.pfx
*.pem
*.key
*.mobileprovision

# 主人数据的本机副本。应用正常将这些文件保存在 Application Support 中。
/local-data/
/backups/
/chat-history.json
/pet-state.json
/pet-memory.json
/weibo-news.json
/meow-memos.json
/meow-mailbox.json

# 参考项目不提交；构建脚本会自动准备固定版本的 iroh-ffi
/vendor/

# 本地模型文件另行下载（见 model/README.md）；云端版无需模型权重
/model/*
!/model/README.md

# Rebuildable output and automatic backups for the current 3D prototype.
/prototypes/lulu-reference-model/image-to-3d/hunyuan-tpose-02/**/*.blend[0-9]
/prototypes/lulu-reference-model/image-to-3d/hunyuan-tpose-02/downloads/
/prototypes/lulu-reference-model/image-to-3d/hunyuan-tpose-02/rigged/preview-frames/
/prototypes/lulu-reference-model/image-to-3d/hunyuan-tpose-02/motion-set-01/frames/
